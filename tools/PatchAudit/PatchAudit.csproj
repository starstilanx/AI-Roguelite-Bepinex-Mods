<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless Harmony patch audit. Not a mod - never deploy this.
    Applies every AIROG mod's patches against AIRL\libs\Assembly-CSharp.dll outside the game,
    so a game update that renames a method / parameter / private field shows up as a report line
    instead of a silent in-game failure. See Program.cs for what is and is not covered.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>PatchAudit</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\AI Roguelike</GameDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\Debug\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Harmony + Cecil come from the game's own BepInEx core so the audit runs the exact
         HarmonyX build the mods run under. Private=False: resolved at runtime by Program.cs. -->
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Mono.Cecil">
      <HintPath>$(GameDir)\BepInEx\core\Mono.Cecil.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="MonoMod.Utils">
      <HintPath>$(GameDir)\BepInEx\core\MonoMod.Utils.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>

</Project>
